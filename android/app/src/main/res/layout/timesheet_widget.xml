<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="6dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

      <TextView
        android:id="@+id/static_duration"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/widget_open_app"
        android:focusable="true"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:shadowColor="#66000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

      <ImageButton
        android:id="@+id/toggle_timesheet"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/widget_toggle_timesheet"
        android:padding="12dp"
        android:src="@drawable/ic_widget_play" />
    </LinearLayout>
</LinearLayout>
